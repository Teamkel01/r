{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "$HOME/.config/fastfetch/logo.png",
    	"type": "kitty-icat",
    	"height": 18,
    	"width": 33,
    	 "padding": {
            "top": 2,
            "right": 6
        }

    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
        "break",
        "break",
	{
            "type": "custom",
            "format": "\u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m"
        },
	"break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "37",
        },
        {
            "type": "battery",
            "key": " ",
            "keyColor": "37"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "37"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m"
        },
        "break",
        "break",
    ]
}
